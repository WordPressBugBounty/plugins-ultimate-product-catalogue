{
  "name": "ultimate-product-catalogue-development",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:php": "php tests/helper-compatibility.php && php tests/request-state.php",
	"build:package": "powershell -NoProfile -ExecutionPolicy Bypass -File build/package.ps1",
	"verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File build/verify-package.ps1 -PackagePath ../release/UPCP-MF-001/ultimate-product-catalogue-5.4.0.zip",
	"phpcs:diff": "node build/phpcs-diff.js --baseline=a694d65cb8785b721f87168ffa14e319c382d28b --standard=phpcs-new-code.xml.dist",
    "env:start": "wp-env start --update",
    "env:start:free": "wp-env start --config=.wp-env.free.json --update",
    "env:start:tests": "wp-env start --config=.wp-env.tests.json --update",
    "env:stop": "wp-env stop",
    "env:stop:free": "wp-env stop --config=.wp-env.free.json",
    "env:stop:tests": "wp-env stop --config=.wp-env.tests.json",
    "env:wp": "wp-env run cli wp",
    "test:php:docker": "wp-env run cli --env-cwd=wp-content/plugins/upcp php tests/helper-compatibility.php",
    "test:integration": "wp-env run cli --config=.wp-env.tests.json --env-cwd=wp-content/plugins/upcp env WP_TESTS_DIR=/wordpress-phpunit vendor/bin/phpunit -c phpunit.xml.dist"
  },
  "devDependencies": {
    "@wordpress/env": "^11.12.0"
  }
}
